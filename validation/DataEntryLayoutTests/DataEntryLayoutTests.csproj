<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <TimelapseBin Condition="'$(TimelapseBin)' == ''">..\..\src\Timelapse\bin\Release\net10.0-windows\win-x64</TimelapseBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Timelapse"><HintPath>$(TimelapseBin)\Timelapse.dll</HintPath></Reference>
    <Reference Include="TimelapseWpf.Toolkit"><HintPath>$(TimelapseBin)\TimelapseWpf.Toolkit.dll</HintPath></Reference>
  </ItemGroup>
</Project>
