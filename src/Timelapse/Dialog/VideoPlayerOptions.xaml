<Window x:Class="Timelapse.Dialog.VideoPlayerOptions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Player Options"
        Width="600" Height="570" MinWidth="600" MinHeight="570"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12"
                   Text="Set keyboard seek speed and optional lightweight live motion boxes."
                   TextWrapping="Wrap" />

        <GroupBox Grid.Row="1" Header="Fast-forward (Up key)" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="FastForwardSlider" Minimum="1" Maximum="64" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="SpeedSlider_ValueChanged" />
                <TextBlock x:Name="FastForwardText" Grid.Column="1" HorizontalAlignment="Right" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Rewind (Down key)" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="RewindSlider" Minimum="1" Maximum="64" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="SpeedSlider_ValueChanged" />
                <TextBlock x:Name="RewindText" Grid.Column="1" HorizontalAlignment="Right" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Live motion bounding boxes">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="MotionBboxEnabledCheckBox" Grid.Row="0" Grid.ColumnSpan="3"
                          Margin="0,0,0,10" Content="Show motion boxes while viewing video" />

                <TextBlock Grid.Row="1" Text="Algorithm" VerticalAlignment="Center" />
                <ComboBox x:Name="MotionAlgorithmComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2">
                    <ComboBoxItem Content="Frame difference (recommended)" Tag="FrameDifference" />
                    <ComboBoxItem Content="MOG2 background model" Tag="Mog2" />
                    <ComboBoxItem Content="Hybrid" Tag="Hybrid" />
                </ComboBox>

                <TextBlock Grid.Row="2" Text="Sensitivity" VerticalAlignment="Center" />
                <ComboBox x:Name="MotionSensitivityComboBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2">
                    <ComboBoxItem Content="High" Tag="14" />
                    <ComboBoxItem Content="Normal (recommended)" Tag="18" />
                    <ComboBoxItem Content="Low" Tag="25" />
                </ComboBox>

                <TextBlock Grid.Row="3" Text="Box padding" VerticalAlignment="Center" />
                <Slider x:Name="MotionPaddingSlider" Grid.Row="3" Grid.Column="1"
                        Minimum="1" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="MotionPaddingSlider_ValueChanged" />
                <TextBlock x:Name="MotionPaddingText" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />

                <TextBlock Grid.Row="4" Text="Bottom timestamp band" VerticalAlignment="Center" />
                <ComboBox x:Name="BottomBandModeComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2"
                          SelectionChanged="BottomBandModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Automatic (recommended)" Tag="Automatic" />
                    <ComboBoxItem Content="Manual" Tag="Manual" />
                    <ComboBoxItem Content="Do not exclude" Tag="None" />
                </ComboBox>

                <TextBlock Grid.Row="5" Text="Manual band height" VerticalAlignment="Center" />
                <Slider x:Name="ManualBottomBandSlider" Grid.Row="5" Grid.Column="1"
                        Minimum="0" Maximum="1080" TickFrequency="4" IsSnapToTickEnabled="True"
                        ValueChanged="ManualBottomBandSlider_ValueChanged" />
                <TextBlock x:Name="ManualBottomBandText" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="4" Margin="0,10,0,0" Foreground="DimGray" TextWrapping="Wrap"
                   Text="Analysis uses a 640-pixel frame and a latest-frame-wins worker. It does not modify the video or saved recognition boxes." />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="90" Margin="0,0,10,0" Content="OK" IsDefault="True" Click="OkButton_Click" />
            <Button Width="90" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
