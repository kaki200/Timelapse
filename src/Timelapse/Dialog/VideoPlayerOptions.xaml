<Window x:Class="Timelapse.Dialog.VideoPlayerOptions"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:toolkit="clr-namespace:TimelapseWpf.Toolkit;assembly=TimelapseWpf.Toolkit"
        Title="VideoPlayer Options" Height="300" Width="600" MinHeight="300" MinWidth="600" Loaded="Window_Loaded">
    <StackPanel Orientation="Vertical" Margin="10">
        <toolkit:FormattedMessageContent x:Name="Message"  Icon="{x:Static toolkit:DialogIconType.Question}"
                            DialogTitle="VideoPlayer Options"
                            What="Adjust the playback speed when holding the UP (fast-forward) or DOWN (rewind) arrow keys."
                            Hint="[li]Higher positive values mean faster playback.[li]Higher negative values mean faster reverse playback." />

        <GroupBox Margin="10,10,10,0" Header="Fast-Forward (UP key) Speed" FontWeight="Bold">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Slider Name="FastForwardSlider" Width="300" Minimum="1.0" Maximum="64.0" IsSnapToTickEnabled="True" TickFrequency="1.0" SmallChange="1.0" LargeChange="4.0" VerticalAlignment="Center"/>
                <TextBlock Name="FastForwardText" Text="--" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Normal" />
            </StackPanel>
        </GroupBox>

        <GroupBox Margin="10,10,10,0" Header="Rewind (DOWN key) Speed" FontWeight="Bold">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Slider Name="RewindSlider" Width="300" Minimum="-64.0" Maximum="-1.0" IsSnapToTickEnabled="True" TickFrequency="1.0" SmallChange="1.0" LargeChange="4.0" VerticalAlignment="Center" />
                <TextBlock Name="RewindText" Text="--" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Normal" />
            </StackPanel>
        </GroupBox>

        <Button x:Name="OkButton" Content="Ok" IsDefault="True" Width="100" Height="30" Margin="0,20,10,0" HorizontalAlignment="Right" Click="OkButton_Click" />
    </StackPanel>
</Window>