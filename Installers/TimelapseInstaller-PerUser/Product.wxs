<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Timelapse (kaki200 fork)" Manufacturer="kaki200"
           Version="$(var.ProductVersion)" UpgradeCode="CD650CEA-B402-4EAA-8B1A-EAEB472B94A9"
           Compressed="yes" InstallerVersion="500" Scope="perUser">
    <SummaryInformation Description="Timelapse fork with keyboard shortcuts and live motion bounding boxes." />
    <MajorUpgrade DowngradeErrorMessage="A newer version of this Timelapse fork is already installed."
                  AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" />
    <Launch Condition="VersionNT64" Message="This application requires 64-bit Windows 10 or later." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Icon Id="TimelapseIcon" SourceFile="..\..\src\Timelapse\Icons\Timelapse.ico" />
    <Property Id="ARPPRODUCTICON" Value="TimelapseIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/kaki200/Timelapse" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Timelapse-Kaki" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Timelapse (kaki200 fork)" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <Feature Id="Application" Title="Timelapse" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="Shortcuts" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="FileHandlers" />
    </Feature>
    <Component Id="Shortcuts" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="StartTimelapse" Name="Timelapse (kaki200 fork)" Target="[INSTALLFOLDER]Timelapse.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="TimelapseIcon" />
      <Shortcut Id="StartViewOnly" Name="Timelapse View Only" Target="[INSTALLFOLDER]Timelapse-ViewOnly.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="TimelapseIcon" />
      <Shortcut Id="StartTemplateEditor" Name="Timelapse Template Editor" Target="[INSTALLFOLDER]TimelapseTemplateEditor.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="TimelapseIcon" />
      <RemoveFolder Id="RemoveStartFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\kaki200\TimelapseFork" Name="Shortcuts" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopTimelapse" Name="Timelapse (kaki200 fork)" Target="[INSTALLFOLDER]Timelapse.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="TimelapseIcon" />
      <RegistryValue Root="HKCU" Key="Software\kaki200\TimelapseFork" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="FileHandlers" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU" Key="Software\Classes\.tdb\OpenWithProgids" Name="TimelapseKaki.tdb" Value="" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.ddb\OpenWithProgids" Name="TimelapseKaki.ddb" Value="" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\TimelapseKaki.tdb" Value="Timelapse Template (kaki200 fork)" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\TimelapseKaki.tdb\shell\open\command" Value="&quot;[INSTALLFOLDER]Timelapse.exe&quot; &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\TimelapseKaki.ddb" Value="Timelapse Database (kaki200 fork)" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\TimelapseKaki.ddb\shell\open\command" Value="&quot;[INSTALLFOLDER]Timelapse.exe&quot; &quot;%1&quot;" Type="string" />
    </Component>
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="InstallerLicense.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="WelcomeDialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
  </Package>
</Wix>
